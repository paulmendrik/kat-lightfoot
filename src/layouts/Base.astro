---
import BaseHead from '@/components/BaseHead.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import "@/styles/global.css";

const { title, description, image } = Astro.props

---

<html lang="en" class="h-full motion-safe:scroll-smooth" >
<head> 
<BaseHead description={description} ogImage={image} title={title} />
</head>
<body  class="flex flex-col items-center h-screen" transition:animate="slide" >
<Head color="#27272A" text="text-zinc-600" />
<div class="w-full flex-grow px-6 lg:px-32 md:px-16">
<div class="w-full lg:py-6 py-4 lg:mb-8 mb-6 border-b-2 border-slate-100">
<div class="prose prose-h2:text-slate-500 lg:prose-xl prose-lg uppercase tracking-widest">{title}</div>
</div>
<slot/>
<br/>
<CookieConsent/>
</div>
<Footer/>
</body>
</html>
