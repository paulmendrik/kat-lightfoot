---
import { Picture } from "astro:assets";
import groq from "groq";
import { urlFor } from "@/sanity/image";
import { sanityClient } from "sanity:client";
import Main from "@/layouts/Main.astro";
import Pagination from "@/components/Pagination.astro";

const paintings = await sanityClient.fetch(
  groq`*[_type in ["paintings"]] | order(order) [0...15]`,
);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate",
);
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, durable, s-maxage=86400, stale-while-revalidate=604800",
);
Astro.response.headers.set(
  "Netlify-Cache-Tag",
  "paintings-list, paintings-pagination",
);

---

<Main title="Kat Lightfoot Paintings" header="Paintings">
  <div class="gallery w-full">
    <div
      class="grid grid-cols-1 lg:grid-cols-3 md:grid-cols-3 lg:gap-16 md:gap-8 gap-6 relative"
    >
      {
        paintings.map((image: any) => (
          <a
            class="painting"
            href={`/paintings/${image.slug?.current}`}
            id={image.order}
          >
            <figure>
              <Picture
                class=" max-w-full overflow-hidden"
                src={urlFor(image.painting).format("webp").sharpen(80).url()}
                inferSize
                alt={image.title}
              />
              <figcaption class=" py-4 text-sm uppercase text-zinc-500 tracking-widest text-center">
                {image.title}
              </figcaption>
            </figure>
          </a>
        ))
      }
    </div>
  </div>
  <Pagination />
  <script src="../../utils/trigger.js"></script>
</Main>
