---
import { Picture } from 'astro:assets';
import Back from '@/components/Back.astro';
import { urlFor } from '@/sanity/image';
import { sanityClient } from "sanity:client";
import Details from "@/layouts/Details.astro";
import Modal from "@/components/Modal.astro";
import SnipCart from '@/components/SnipCart.astro';

const { slug } = Astro.params;

const item = await sanityClient.fetch(
  `*[_type == "giclee" && slug.current == $slug][0]`,
  { slug },
);

if (!item) return Astro.redirect("/404");

const { title, painting, size, price, printsize, tubedprice, sold } = item;


Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate",
);
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, durable, s-maxage=86400, stale-while-revalidate=604800",
);
Astro.response.headers.set("Netlify-Cache-Tag", `giclee-${slug}, giclee-list`);

---

<Details title={title} >

<Back/>


<div class="flex flex-col lg:flex-row md:flex-row w-full pt-24">
<div class="aside order-2 pb-8 lg:order-1 md:order-1 lg:w-1/3 md:w-1/3 lg:pr-20 md:pr-8  w-full">
<h1 class="prose prose-xl pb-6 mb-6 text-black uppercase tracking-widest border-b-2 border-slate-100 ">Katharine Lightfoot</h1>
<p class="prose prose-lg py-2 text-black uppercase">{title}</p>

{ printsize ?
<p class="printsize prose prose-base py-2  text-zinc-500 uppercase">{printsize}</p>
: null
}

{ tubedprice ? 
<p class="tubedprice prose prose-base py-2 text-black uppercase">{tubedprice}</p>
: null
}

{sold ? 
<p class="sold prose prose-base py-2 text-zinc-500 uppercase">Sold Out</p>
: 

<div class=" py-4" id="default-tab-content">
<button class="snipcart-add-item prose prose-sm py-2 px-4 border border-gray-300 uppercase bg-neutral-950 font-medium text-white tracking-widest opacity-75 w-full"
data-item-id={slug}
data-item-image={urlFor(painting).url()}
data-item-name={title}
data-item-description="Giclee Print in Tube."
data-item-url={`/giclee/${slug}`}
data-item-price={tubedprice}
data-item-max-quantity=1
data-item-custom1-name=""
data-item-custom1-type="readonly"
data-item-custom1-value="Giclee Print in Tube"
>
Add to Cart
</button>
</div>
}

<Modal title={title} painting={painting} price={price} size={size} />


</div>

<div class="canvas order-1 pb-8 lg:order-2 md:order-2 lg:w-2/3 md:w-2/3 w-full" >
<Picture class='view h-auto object-cover' src={urlFor(painting).format('webp').sharpen(100).url()} inferSize alt={title} /> 
</div>

</div>
</Details>

<script>
const message = document.querySelectorAll('button.alert');
message.forEach((button) => {
button.addEventListener('click', () => {
alert('Please select a Purchase Option !');
});
});
</script>

<SnipCart/>