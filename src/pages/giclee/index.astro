---
import { Picture } from "astro:assets";
import { urlFor } from "@/sanity/image";
import { sanityClient } from "sanity:client";
import Main from "@/layouts/Main.astro";
const giclee = await sanityClient.fetch(`*[_type == "giclee"] | order(order)`);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate",
);
Astro.response.headers.set(
  "Netlify-CDN-Cache-Control",
  "public, durable, s-maxage=86400, stale-while-revalidate=604800",
);
Astro.response.headers.set("Netlify-Cache-Tag", "giclee-list");

---

<Main title="Giclee Prints" header="Giclee Prints">
  <div class="gallery w-full">
    <div
      class="grid grid-cols-1 lg:grid-cols-3 md:grid-cols-3 lg:gap-16 md:gap-8 gap-6 relative"
    >
      {
        giclee.map((image: any) => (
          <a
            class="painting"
            href={`/giclee/${image.slug?.current}`}
            id={image.order}
          >
            <figure>
              <Picture
                class=" max-w-full overflow-hidden"
                src={urlFor(image.painting).format("webp").sharpen(100).url()}
                inferSize
                alt={image.title}
              />
              <figcaption class="py-4 text-sm uppercase text-zinc-500  text-center">
                {image.title}
              </figcaption>
            </figure>
          </a>
        ))
      }
    </div>
  </div>
  <script src="@/utils/stagger.js"></script>
</Main>
